{
    "version": 2,
    "builds": [
      { 
        "src": "frontend/package.json", 
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist",
          "installCommand": "npm ci",
          "buildCommand": "npm run build"
        }
      },
      { 
        "src": "api/app.py",
        "use": "@vercel/python",
        "config": {
          "maxLambdaSize": "50mb"
        }
      }
    ],
    "routes": [
      { 
        "src": "/api/(.*)", 
        "dest": "api/app.py"
      },
      { 
        "src": "/(.*)", 
        "dest": "frontend/dist/$1"
      }
    ]
  } 